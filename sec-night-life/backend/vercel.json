{
  "version": 2,
  "buildCommand": "npm run build",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "assets/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-promotions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/complete-parties",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-table-boosts",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/expire-day-table-sessions",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/event-interest-reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/weekend-reminder",
      "schedule": "0 10 * * 5"
    },
    {
      "path": "/api/cron/retry-payouts",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/weekly-payouts",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/repair-payment-fulfillment",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expire-external-listings",
      "schedule": "15 8 * * *"
    }
  ]
}
