// ─── Events & Tables ──────────────────────────────────────────────────────
model Event {
  id                String      @id @default(uuid())
  venueId           String      @map("venue_id")
  title             String
  description       String?
  date              DateTime
  city              String
  locationAddress   String?     @map("location_address")
  locationCity      String?     @map("location_city")
  locationSuburb    String?     @map("location_suburb")
  locationProvince  String?     @map("location_province")
  status            EventStatus @default(draft)
  isFeatured        Boolean     @default(false) @map("is_featured")
  boosted            Boolean     @default(false)
  boostedAt          DateTime?   @map("boosted_at")
  boostExpiresAt     DateTime?   @map("boost_expires_at")
  boostPaystackRef   String?     @map("boost_paystack_ref")
  coverImageUrl     String?     @map("cover_image_url")
  bannerUrl         String?     @map("banner_url")
  ticketTiers       Json?       @map("ticket_tiers")
  startTime         String?     @map("start_time")
  /// When the event is considered ended (QR, feeds, listings). Backfilled for legacy rows.
  endsAt            DateTime?   @map("ends_at")
  hasEntranceFee    Boolean     @default(false) @map("has_entrance_fee")
  entranceFeeAmount Float?      @map("entrance_fee_amount")
  hostingConfig     Json?       @map("hosting_config")
  eventFormat       EventFormat @default(TABLE_HOSTING) @map("event_format")
  /// When true, ticket buyers can add venue menu items at checkout (ticketed events only).
  allowsTicketMenuAddons Boolean @default(false) @map("allows_ticket_menu_addons")
  /// Optional bcrypt hash for venue door staff when recording ticket admits (4–8 digits).
  doorCheckPinHash   String?     @map("door_check_pin_hash")
  /// Optional door verification code shown on tickets/QR (PREFIX-MMDD-SUFFIX, unique per venue).
  eventCode         String?     @map("event_code")
  showSeatingPlan   Boolean     @default(false) @map("show_seating_plan")
  seatingPlanId     String?     @map("seating_plan_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  venue         Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seatingPlan   VenueSeatingPlan? @relation("EventSeatingPlan", fields: [seatingPlanId], references: [id], onDelete: SetNull)
  tables        Table[]
  hostedTables  HostedTable[]
  venueTables   VenueTable[]
  jobs          Job[]
  attendees     EventAttendance[]
  promotedPosts Promotion[]
  groupChat     GroupChat?
  userReviews   UserReview[]
  eventInterestRemindersSent EventInterestReminderSent[]
  eventVenueTableBookings    EventVenueTableBooking[]
  promoterAssignments        EventPromoterAssignment[]
  promoterConversions        PromoterConversion[]

  @@unique([venueId, eventCode])
  @@index([venueId])
  @@index([date])
  @@index([endsAt])
  @@index([status])
  @@index([city])
  @@index([boosted, boostExpiresAt])
  @@index([deletedAt, status, endsAt])
  @@map("events")
}

model EventAttendance {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  confirmed Boolean  @default(false)
  checkedIn Boolean  @default(false) @map("checked_in")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_attendance")
}

model Table {
  id              String      @id @default(uuid())
  eventId         String      @map("event_id")
  venueId         String      @map("venue_id")
  hostUserId      String      @map("host_user_id")
  name            String
  tableCategory   TableCategory @default(general) @map("table_category")
  status          TableStatus @default(open)
  maxGuests       Int         @map("max_guests")
  currentGuests   Int         @default(0) @map("current_guests")
  minSpend        Float?      @map("min_spend")
  joiningFee              Float?                 @map("joining_fee")
  isPublic                Boolean                @default(true) @map("is_public")
  guestGenderPreference   GuestGenderPreference  @default(ANY) @map("guest_gender_preference")
  hostFeePaystackRef      String?                @unique @map("host_fee_paystack_ref")
  members                 Json                   @default("[]")
  pendingRequests         Json                   @default("[]") @map("pending_requests")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  deletedAt               DateTime?              @map("deleted_at")

  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  host        User           @relation("TableHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  bookings    TableBooking[]
  userReviews UserReview[]

  @@index([eventId])
  @@index([venueId])
  @@index([hostUserId])
  @@index([status])
  @@map("tables")
}

// ─── Tier 2: Freelancers / Jobs ───────────────────────────────────────────
model Job {
  id                 String    @id @default(uuid())
