  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  sender      User           @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  replyTo     JobMessage?    @relation("JobMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies     JobMessage[]   @relation("JobMessageReplies")

  @@index([applicationId])
  @@index([jobPostingId])
  @@index([senderUserId])
  @@index([sentAt])
  @@index([readAt])
  @@map("job_messages")
}

model ServiceRating {
