// Canonical Payment record — all Paystack payments stored here
model Payment {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  email           String
  amount          Float
  reference       String              @unique // Paystack reference
  status          String // pending | success | failed
  type            String // event | table | promotion | ticket | other
  metadata        Json?
  refundStatus    PaymentRefundStatus @default(NONE) @map("refund_status")
  refundedAt      DateTime?           @map("refunded_at")
  refundRequestId String?             @unique @map("refund_request_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  refundRequest RefundRequest? @relation(fields: [refundRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([type])
  @@index([refundStatus])
  @@map("payments")
}

/// Per paid order: venue staff marked menu / min-spend as served (not door entry).
model OrderFulfillment {
