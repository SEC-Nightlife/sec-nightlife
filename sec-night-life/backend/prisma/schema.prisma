  user     User @relation("PromoterFollowing", fields: [userId], references: [id], onDelete: Cascade)
  promoter User @relation("PromoterFollowers", fields: [promoterId], references: [id], onDelete: Cascade)

  @@unique([userId, promoterId])
  @@index([userId])
  @@index([promoterId])
  @@map("promoter_follows")
}

model Promotion {
  id                 String          @id @default(cuid())
  venueId            String          @map("venue_id")
  eventId            String?         @map("event_id")
  type               PromotionType   @map("promotion_type")
  title              String
  description        String          @db.Text
  imageUrl           String?         @map("image_url")
  imagePublicId      String?         @map("image_public_id")
  targetCity         String?         @map("target_city")
  status             PromotionStatus @default(DRAFT)
  startAt            DateTime        @map("start_at")
  endAt              DateTime        @map("end_at")
  boosted            Boolean         @default(false)
  boostedAt          DateTime?       @map("boosted_at")
  boostExpiresAt     DateTime?       @map("boost_expires_at")
  boostPaystackRef   String?         @map("boost_paystack_ref")
  boostImpressions   Int             @default(0) @map("boost_impressions")
  organicImpressions Int             @default(0) @map("organic_impressions")
  totalClicks        Int             @default(0) @map("total_clicks")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")

