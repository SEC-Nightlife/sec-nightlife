model PromoterVenueThread {
  id               String    @id @default(cuid())
  venueId          String    @map("venue_id")
  promoterUserId   String    @map("promoter_user_id")
  jobApplicationId String?   @map("job_application_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  promoterHiddenAt DateTime? @map("promoter_hidden_at")
  venueHiddenAt    DateTime? @map("venue_hidden_at")

  venue    Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  promoter User                   @relation("PromoterVenueThreadUser", fields: [promoterUserId], references: [id], onDelete: Cascade)
  messages PromoterVenueMessage[]

  @@unique([venueId, promoterUserId])
  @@index([promoterUserId])
  @@map("promoter_venue_threads")
}

model PromoterVenueMessage {
  id               String    @id @default(cuid())
  threadId         String    @map("thread_id")
  senderUserId     String?   @map("sender_user_id")
  body             String    @db.Text
  kind             String    @default("TEXT")
  eventId          String?   @map("event_id")
  replyToMessageId String?   @map("reply_to_message_id")
  sentAt           DateTime  @default(now()) @map("sent_at")
  readAt           DateTime? @map("read_at")

  thread  PromoterVenueThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender  User?                @relation("PromoterVenueMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  replyTo PromoterVenueMessage? @relation("PromoterVenueMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies PromoterVenueMessage[] @relation("PromoterVenueMessageReplies")

  @@index([threadId, sentAt])
  @@map("promoter_venue_messages")
}

model WeekendReminderSent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  weekKey   String   @map("week_key")
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@map("weekend_reminder_sent")
}

model PushDeviceToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("push_device_tokens")
}
