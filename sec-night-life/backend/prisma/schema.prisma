model HostedTable {
  id               String            @id @default(cuid())
  hostUserId       String            @map("host_user_id")
  tableType        TableSourceType   @map("table_type")
  tableName        String            @map("table_name")
  tableDescription String?           @map("table_description") @db.Text
  eventType        TableEventType    @map("event_type")
  /// Where this listing appears on Home: Available Tables vs Events.
  listingSurface   HostedListingSurface @default(TABLE) @map("listing_surface")
  eventId          String?           @map("event_id")
  venueName        String            @map("venue_name")
  venueAddress     String?           @map("venue_address")
  eventDate                   DateTime                @map("event_date")
  eventTime                   String                  @map("event_time")
  /// Optional end calendar date for EXTERNAL_VENUE own-place listings (defaults to eventDate).
  eventEndDate                DateTime?               @map("event_end_date")
  /// Optional end clock HH:mm (SAST) for EXTERNAL_VENUE own-place listings.
  eventEndTime                String?                 @map("event_end_time")
  joiningFee                  Float?                  @map("joining_fee")
  hasJoiningFee               Boolean                 @default(false) @map("has_joining_fee")
  guestGenderPreference       GuestGenderPreference   @default(ANY) @map("guest_gender_preference")
  externalListingPaystackRef  String?                 @map("external_listing_paystack_ref")
  photo            String?
  photoPublicId    String?           @map("photo_public_id")
  drinkPreferences String?           @map("drink_preferences")
  desiredCompany   String?           @map("desired_company")
  guestQuantity    Int               @map("guest_quantity")
  spotsRemaining   Int               @map("spots_remaining")
  isPublic         Boolean           @default(true) @map("is_public")
  status           HostedTableStatus @default(ACTIVE)
  boosted          Boolean           @default(false)
  boostedAt        DateTime?         @map("boosted_at")
  boostExpiresAt   DateTime?         @map("boost_expires_at")
  boostPaystackRef String?           @map("boost_paystack_ref")
  hostingCategory        HostingTableCategory? @map("hosting_category")
  hostingTierIndex       Int?                @map("hosting_tier_index")
  tierMaxGuests          Int?                @map("tier_max_guests")
  tierMinSpend           Float?              @map("tier_min_spend")
  menuSpendTotal         Float               @default(0) @map("menu_spend_total")
  tierIncludedItems      Json?               @map("tier_included_items")
  hostFeePaystackRef     String?             @unique @map("host_fee_paystack_ref")
  /// Day-booking inventory slot this session occupies (null for event/external tables).
  venueTableId           String?             @map("venue_table_id")
  /// Canonical end instant for day-booking / own-place listing expiry (SAST-aligned).
  windowEndsAt           DateTime?           @map("window_ends_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  host       User                @relation("HostedTableHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  event      Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venueTable VenueTable?         @relation("HostedTableDaySlot", fields: [venueTableId], references: [id], onDelete: SetNull)
  members    HostedTableMember[]
  invites    TableInvite[]
  groupChat  HostedTableGroupChat?
  eventVenueBookings EventVenueTableBooking[]

  @@index([hostUserId])
  @@index([status])
  @@index([eventDate])
  @@index([venueTableId])
  @@index([windowEndsAt])
  @@index([status, spotsRemaining, eventDate])
  @@map("hosted_tables")
}

