  applicantHiddenAt   DateTime?         @map("applicant_hidden_at")

  jobPosting JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant  User         @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
